#!/bin/sh
# NetworkManager runs this when a connection changes (installed in dispatcher.d by install.sh).
# With Ethernet and Wi-Fi on the same network, replies to the Wi-Fi address would leave over
# Ethernet and connections to it hang, while <hostname>.local can hand out either address.
# So what comes from the Wi-Fi address goes back out over Wi-Fi. Ethernet stays the box's
# default way out, and with Wi-Fi alone this changes nothing.
DEV="$1" ACTION="$2"
TABLE=100
[ -d "/sys/class/net/$DEV/wireless" ] || exit 0

# Other events (an IPv6 address arriving, say) must leave the rule as it is.
case "$ACTION" in
  up|dhcp4-change|reapply|down) ;;
  *) exit 0 ;;
esac
ip rule del pref "$TABLE" 2>/dev/null
ip route flush table "$TABLE" 2>/dev/null
[ "$ACTION" != down ] || exit 0

ADDR="$(ip -4 -o addr show dev "$DEV" | awk '{sub("/.*", "", $4); print $4; exit}')"
GATEWAY="$(ip -4 route show default dev "$DEV" | awk '{print $3; exit}')"
SUBNET="$(ip -4 route show dev "$DEV" scope link | awk '{print $1; exit}')"
[ -n "$ADDR" ] || exit 0
[ -z "$SUBNET" ] || ip route replace "$SUBNET" dev "$DEV" src "$ADDR" table "$TABLE"
[ -z "$GATEWAY" ] || ip route replace default via "$GATEWAY" dev "$DEV" table "$TABLE"
ip rule add pref "$TABLE" from "$ADDR" lookup "$TABLE"
