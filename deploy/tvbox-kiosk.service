[Unit]
Description=TV box display (cage + Chromium kiosk on tty1)
After=systemd-user-sessions.service tvbox-server.service dbus.socket systemd-logind.service getty@tty1.service
Wants=dbus.socket systemd-logind.service tvbox-server.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User=@USER@
# A real login session on tty1 gives cage the seat and the user's PipeWire.
PAMName=tvbox-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=@APP_DIR@/deploy/kiosk-session.sh
# Chromium's errors go to the journal (not the TV's console), so a crash leaves a trace;
# rate-limited so a misbehaving page can't flood it.
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=300
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
